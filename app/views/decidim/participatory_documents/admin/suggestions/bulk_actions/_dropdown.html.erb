<div id="js-bulk-actions-wrapper" class="relative">
  <button
    id="js-bulk-actions-button"
    class="button button__sm button__transparent-secondary"
    type="button"
    data-controller="dropdown"
    data-target="js-bulk-actions-dropdown">
    <%= t("decidim.participatory_documents.admin.suggestions.index.actions.title") %>
    <%= icon "arrow-down-s-line" %>
    <%= icon "arrow-down-s-line" %>
  </button>

  <ul
    id="js-bulk-actions-dropdown"
    class="dropdown dropdown__bottom"
    aria-hidden="true">
    <li class="dropdown__item">
      <button type="button" class="dropdown__button" data-action="assign-suggestions-to-evaluator">
        <%= t("decidim.participatory_documents.admin.suggestions.index.actions.assign_to_evaluator") %>
      </button>
    </li>
    <li class="dropdown__item">
      <button type="button" class="dropdown__button" data-action="unassign-suggestions-from-evaluator">
        <%= t("decidim.participatory_documents.admin.suggestions.index.actions.unassign_from_evaluator") %>
      </button>
    </li>
    <li class="dropdown__item">
      <button type="button" class="dropdown__button" data-action="publish-answers">
        <%= t("decidim.participatory_documents.admin.suggestions.index.actions.publish_answers") %>
      </button>
    </li>
  </ul>
</div>
