<div class="item__edit-form">
  <% if suggestion.evaluators.any? || allowed_to?(:assign_to_evaluator, :suggestions) %>
    <div class="card">
      <div class="card-divider">
        <h2 class="card-title"><%= t ".evaluators" %></h2>
      </div>

      <div class="card-section">
        <div class="row column">
          <% if suggestion.evaluators.any? %>
            <strong><%= t ".assigned_evaluators" %>:</strong>
            <ul id="evaluators">
              <% suggestion.evaluation_assignments.each do |assignment| %>
                <% presented_evaluator = present(assignment.evaluator) %>
                <li class="flex items-center">
                  <%= link_to(
                        presented_evaluator.name,
                        presented_evaluator.profile_path,
                        target: :blank,
                        class: "mr-2"
                      ) %>
                  <% if evaluator_assigned_to_suggestion? || current_user.admin? %>
                    <%= icon_link_to(
                          "close-circle-line",
                          document_suggestion_evaluation_assignment_path(document, suggestion, assignment.evaluator_role),
                          t(".remove_assignment"),
                          method: :delete,
                          data: { confirm: t(".remove_assignment_confirmation") },
                          class: "close-icon text-alert"
                        ) %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <%= render "decidim/participatory_documents/admin/suggestions/add_evaluators" %>

        </div>
      </div>
    </div>
  <% end %>
</div>
